{
	"editor.inlineSuggest.enabled": false,
	"Lua.diagnostics.globals": [
		"grid_size_x",
		"grid_size_y",
		"grid_led",
		"grid_refresh",
		"grid_led_all",
		"midi_note_off",
		"midi_note_on",
		"linlin",
		"round",
		"metro",
		"get_time",
		"clamp",
		"grid_led_get",
		"midi_cc"
	],
	"Lua.diagnostics.disable": [
		"lowercase-global"
	],
	"Lua.codeLens.enable": true,
	"Lua.completion.callSnippet": "Both",
	"Lua.completion.displayContext": 1,
	"markdown-pdf.breaks": true,
	"markdown-pdf.convertOnSave": true,
	"markdown-pdf.convertOnSaveExclude": [
			"^(?!-manual.md$).+$"
	],
	"markdown-pdf.displayHeaderFooter": true,
	"markdown-pdf.outputDirectory": "./manuals/",
	"markdown-pdf.footerTemplate": "<div style=\"font-size: 9px; margin: 0 auto;\"> <span class='pageNumber'></span> of <span class='totalPages'></span></div>",
	"markdown-pdf.headerTemplate": "<div></div>",
	"markdown-pdf.type": [
			"pdf"
	],
	"markdownlint.run": "onSave",
	"markdownlint.configFile": ".markdownlint.json",
	"terminal.integrated.profiles.windows": {
		"PowerShell": {
			"path": "powershell.exe",
			"args": [
				"-NoExit",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\.venv\\Scripts\\Activate.ps1"
			]
		},
		"GitBash": {
			"path": "C:\\Program Files\\Git\\bin\\bash.exe",
			"args": [
				"--rcfile",
				"${workspaceFolder}/.venv/Scripts/activate.sh",
				"-i"
			]
		}
	},
	"terminal.integrated.defaultProfile.windows": "PowerShell",
	"terminal.integrated.profiles.osx": {
		"Bash": {
			"path": "bash",
			"args": [
				"--no-rcs",
				"-c",
				"source ~/.bashrc; source ${workspaceFolder}/.venv/Scripts/activate"
			]
		}
	},
	"terminal.integrated.defaultProfile.osx": "Bash",
}